# =========================================================================
# Environment Variables & Backend Secrets Template
# Copy this file to '.env' or use Unity ScriptableObject/Config loader
# DO NOT COMMIT THE ACTUAL '.env' OR SECRET KEYS TO GIT!
# =========================================================================

# --- Supabase Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- LLM API Configuration (Milestone 3: Death Report / AI Dialog) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Game Environment ---
GAME_ENV=development # development | staging | production
DEBUG_MODE=true
